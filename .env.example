# Local development only. Never commit real passwords.
BONITA_URL=http://localhost:8080/bonita
BONITA_USER=
BONITA_PASSWORD=
# Shared secret for Bonita REST connector -> Flask calls
INTEGRATION_API_KEY=
# Existing Bonita process case variable names (java.lang.String)
CONTRACT_STATUS_VARIABLE=
CONTRACT_DOCUMENT_ID_VARIABLE=
FINANCE_DATA_VARIABLE=
FINANCE_READY_VARIABLE=
# For finance emails
PUBLIC_BASE_URL=http://localhost:5000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Generate a permanent Flask key (e.g. python -c 'import secrets; print(secrets.token_hex(32))')
FLASK_SECRET_KEY=
PORT=5000
